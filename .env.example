# Production Firebase project
FIREBASE_PROJECT_ID="mom-haven"
FIRESTORE_DATABASE_ID="mom-haven"
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"

# Server-side Haven configuration. Never expose GEMINI_API_KEY as VITE_GEMINI_API_KEY.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Optional public application URL used for absolute links/callbacks.
APP_URL="https://mom-haven.web.app"
