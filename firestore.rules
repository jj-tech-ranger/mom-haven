rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function owner(uid){return signed()&&request.auth.uid==uid;}
  function isPartner(){return signed()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='PARTNER';}
  function isClinician(){return signed()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='CLINICIAN';}
  function isAdmin(){return signed()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='ADMIN';}
  function activePartner(motherId){return signed()&&exists(/databases/$(database)/documents/partnerRelationships/$(motherId + '_' + request.auth.uid))&&get(/databases/$(database)/documents/partnerRelationships/$(motherId + '_' + request.auth.uid)).data.status=='active';}
  match /users/{uid}{allow read,write:if owner(uid);}
  match /motherProfiles/{uid}{allow read,write:if owner(uid);}
  match /healthContexts/{uid}{allow read:if owner(uid);allow write:if owner(uid)&&!request.resource.data.keys().hasAny(['authoritativeDiagnosis','verifiedBloodPressure','clinicalConditions','verifiedMedications','verifiedBy','verifiedAt','pmtctStatus','heiStatus']);}
  match /healthContextVersions/{uid}/versions/{versionId}{allow read:if owner(uid);allow write:if owner(uid)&&!request.resource.data.keys().hasAny(['authoritativeDiagnosis','verifiedBloodPressure','clinicalConditions','verifiedMedications','verifiedBy','verifiedAt','pmtctStatus','heiStatus']);}
  match /pregnancies/{id}{allow read:if signed()&&resource.data.motherId==request.auth.uid&&!isPartner()&&!isClinician()&&!isAdmin();allow create:if owner(request.resource.data.motherId);allow update:if signed()&&resource.data.motherId==request.auth.uid&&!isClinician()&&!isAdmin();allow update:if signed()&&activePartner(resource.data.motherId)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['birthPlan','updatedAt'])&&request.resource.data.birthPlan.diff(resource.data.birthPlan).affectedKeys().hasOnly(['transportPlan']);match /{sub=**}{allow read,write:if signed()&&get(/databases/$(database)/documents/pregnancies/$(id)).data.motherId==request.auth.uid&&!isClinician()&&!isAdmin();}}
  match /children/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();match /{sub=**}{allow read,write:if signed()&&get(/databases/$(database)/documents/children/$(id)).data.motherId==request.auth.uid&&!isClinician()&&!isAdmin();}}
  match /familyPlanning/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /cancerScreenings/{id}{allow read:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();allow write:if false;}
  match /pmtctRecords/{id}{allow read:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();allow write:if false;}
  match /antenatalProfiles/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /eyeCareAssessments/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /toothEruptions/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /aefiReports/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /hospitalAdmissions/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /specialClinicalAttendances/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /birthPlans/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /dailyHealthLogs/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.userId==request.auth.uid)||(resource!=null&&resource.data.userId==request.auth.uid))&&!isClinician()&&!isAdmin();}
  match /reminders/{id}{allow read:if signed()&&((resource.data.userId==request.auth.uid)||(activePartner(resource.data.userId)&&resource.data.sharedWithPartner==true));allow write:if signed()&&((resource.data.userId==request.auth.uid)||(resource==null&&request.resource.data.userId==request.auth.uid));}
  match /notifications/{id}{allow read,write:if owner(resource.data.userId);}
  match /emergencyContacts/{id}{allow read,write:if owner(resource.data.userId);}
  match /savedEmergencyFacilities/{id}{allow read,write:if owner(resource.data.userId);}
  match /emergencyDefaults/{id}{allow read:if signed()&&resource.data.verified==true;allow write:if isAdmin();}
  match /partnerConnections/{id}{allow read:if signed()&&resource.data.status=='pending';allow create:if owner(request.resource.data.motherId);allow update:if signed()&&(resource.data.motherId==request.auth.uid||resource.data.usedBy==request.auth.uid);}
  match /partnerRelationships/{id}{allow read:if signed()&&((resource.data.motherId==request.auth.uid)||(resource.data.partnerId==request.auth.uid)||(resource.data.status=='pending'&&id==resource.data.code));allow create:if owner(request.resource.data.motherId)&&request.resource.data.partnerId==null&&request.resource.data.status=='pending';allow create:if signed()&&isPartner()&&request.resource.data.partnerId==request.auth.uid&&request.resource.data.status=='active'&&request.resource.data.code is string&&exists(/databases/$(database)/documents/partnerRelationships/$(request.resource.data.code))&&get(/databases/$(database)/documents/partnerRelationships/$(request.resource.data.code)).data.status=='pending'&&get(/databases/$(database)/documents/partnerRelationships/$(request.resource.data.code)).data.motherId==request.resource.data.motherId&&get(/databases/$(database)/documents/partnerRelationships/$(request.resource.data.code)).data.code==request.resource.data.code;allow update:if signed()&&(resource.data.motherId==request.auth.uid||resource.data.partnerId==request.auth.uid||(resource.data.status=='pending'&&request.resource.data.status=='used'&&request.resource.data.usedBy==request.auth.uid));}
  match /partnerShares/{motherId}{allow read:if owner(motherId)||activePartner(motherId);allow create,update:if owner(motherId);}
  match /pregnancySummaries/{motherId}{allow read:if owner(motherId)||activePartner(motherId);allow create,update:if owner(motherId);}
  match /clinicianAccessSessions/{id}{allow read:if owner(resource.data.motherId);allow create:if signed()&&request.resource.data.motherId==request.auth.uid&&request.resource.data.clinicianId==null&&request.resource.data.status=='active'&&request.resource.data.shareCode is string&&request.resource.data.shareCode.size()==6&&request.resource.data.expiresAt is timestamp&&request.resource.data.expiresAt>request.time;allow update:if owner(resource.data.motherId)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])&&request.resource.data.status in ['active','expired','revoked'];}
  match /consentRecords/{id}{allow read:if isAdmin()||(signed()&&resource.data.motherId==request.auth.uid);allow create:if owner(request.resource.data.motherId)||(signed()&&request.resource.data.targetId==request.auth.uid);allow update:if owner(resource.data.motherId)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt']);}
  match /careTeamMessages/{id}{allow read:if signed()&&((resource.data.motherId==request.auth.uid)||(isClinician()&&(resource.data.clinicianId==request.auth.uid||resource.data.motherId is string)));allow write:if signed()&&((resource!=null&&resource.data.motherId==request.auth.uid)||(resource==null&&request.resource.data.motherId==request.auth.uid)||(isClinician()&&((resource==null&&request.resource.data.clinicianId==request.auth.uid)||(resource!=null&&resource.data.clinicianId==request.auth.uid))));}
  match /facilityRosters/{id}{allow read:if isAdmin()||(isClinician()&&exists(/databases/$(database)/documents/clinicians/$(request.auth.uid))&&get(/databases/$(database)/documents/clinicians/$(request.auth.uid)).data.facilityId==resource.data.facilityId);allow write:if false;}
  match /clinicianPrivateNotes/{id}{allow read,write:if false;}
  match /auditEvents/{id}{allow read:if isAdmin();allow write:if false;}
  match /facilities/{id}{allow read:if signed();allow write:if isAdmin();}
  match /clinicians/{id}{allow read,write:if isAdmin();}
  match /adminMfaSecrets/{id}{allow read,write:if false;}
  match /clinicianMfaSecrets/{id}{allow read,write:if false;}
  match /clinicalDecisionRegister/{id}{allow read,write:if isAdmin();}
  match /weeklySummaries/{id}{allow read,write:if isAdmin();}
  match /releaseGates/{id}{allow read,write:if isAdmin();}
  match /safetyPatterns/{id}{allow read:if signed();allow write:if isAdmin();}
  match /aggregateInsightBuckets/{id}{allow read:if signed();allow write:if false;}
  match /reportExports/{id}{allow read:if isAdmin()||(signed()&&resource.data.generatedFor==request.auth.uid);allow write:if false;}
  match /educationalContent/{id}{allow read:if (signed()&&resource.data.status=='published')||isAdmin();allow write:if isAdmin();}
  match /emergencyGuidance/{id}{allow read:if signed();allow write:if isAdmin();}
  match /havenSessions/{sessionId}{allow read,write:if owner(resource.data.userId)||owner(request.resource.data.userId);match /messages/{messageId}{allow read,write:if signed()&&get(/databases/$(database)/documents/havenSessions/$(sessionId)).data.userId==request.auth.uid;}}
  match /{document=**}{allow read,write:if false;}
 }
}
