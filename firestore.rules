rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users/{uid} — user can read/write their own document
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // motherProfiles/{uid} — user can read/write their own profile
    match /motherProfiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    // pregnancies/{pregnancyId} — user can read/write if motherId == request.auth.uid
    match /pregnancies/{pregnancyId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.motherId == request.auth.uid) ||
        (resource != null && resource.data.motherId == request.auth.uid)
      );

      // Subcollections under pregnancy (e.g. ancEncounters)
      match /{subcollection=**} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/pregnancies/$(pregnancyId)).data.motherId == request.auth.uid
        );
      }
    }

    // children/{childId} — user can read/write if motherId == request.auth.uid
    match /children/{childId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.motherId == request.auth.uid) ||
        (resource != null && resource.data.motherId == request.auth.uid)
      );

      // Subcollections under child (immunization, growth, etc.)
      match /{subcollection=**} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/children/$(childId)).data.motherId == request.auth.uid
        );
      }
    }

    // birthPlans/{planId}
    match /birthPlans/{planId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.motherId == request.auth.uid) ||
        (resource != null && resource.data.motherId == request.auth.uid)
      );
    }

    // reminders/{reminderId} — user can read/write their own reminders
    match /reminders/{reminderId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // notifications/{notificationId} — user can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // emergencyContacts/{id} & savedEmergencyFacilities/{id}
    match /emergencyContacts/{id} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }
    match /savedEmergencyFacilities/{id} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // NOTE: clinicianPrivateNotes/{id} must NEVER be readable by MOTHER or PARTNER roles.
    
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
