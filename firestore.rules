rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function owner(uid){return signed()&&request.auth.uid==uid;}
  match /users/{uid}{allow read,write:if owner(uid);}
  match /motherProfiles/{uid}{allow read,write:if owner(uid);}
  match /pregnancies/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid));match /{sub=**}{allow read,write:if signed()&&get(/databases/$(database)/documents/pregnancies/$(id)).data.motherId==request.auth.uid;}}
  match /children/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid));match /{sub=**}{allow read,write:if signed()&&get(/databases/$(database)/documents/children/$(id)).data.motherId==request.auth.uid;}}
  match /birthPlans/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.motherId==request.auth.uid)||(resource!=null&&resource.data.motherId==request.auth.uid));}
  match /reminders/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.userId==request.auth.uid)||(resource!=null&&resource.data.userId==request.auth.uid));}
  match /notifications/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.userId==request.auth.uid)||(resource!=null&&resource.data.userId==request.auth.uid));}
  match /emergencyContacts/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.userId==request.auth.uid)||(resource!=null&&resource.data.userId==request.auth.uid));}
  match /savedEmergencyFacilities/{id}{allow read,write:if signed()&&((resource==null&&request.resource.data.userId==request.auth.uid)||(resource!=null&&resource.data.userId==request.auth.uid));}
  // Connection codes are bearer secrets. Only signed-in accounts can query them; a code document exposes no clinical data.
  match /partnerConnections/{id}{allow read:if signed();allow create:if signed()&&request.resource.data.motherId==request.auth.uid;allow update:if signed()&&(resource.data.motherId==request.auth.uid||resource.data.usedBy==request.auth.uid);}
  match /partnerRelationships/{id}{allow read,write:if signed()&&(resource.data.motherId==request.auth.uid||resource.data.partnerId==request.auth.uid||(resource==null&&request.resource.data.partnerId==request.auth.uid));}
  match /{document=**}{allow read,write:if false;}
 }
}
