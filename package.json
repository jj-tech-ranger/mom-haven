{
  "name": "mom-haven",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "test": "npm run test:clinical && npm run test:context && npm run test:anonymous && npm run test:haven-context && npm run test:today && npm run test:resources && npm run test:summary && npm run test:sharing && npm run test:partner-signal && npm run test:child && npm run test:reminders && npm run test:demo",
    "test:clinical": "tsx src/utils/clinicalCalculations.test.ts",
    "test:context": "tsx src/services/healthContextService.test.ts",
    "test:anonymous": "tsx src/services/anonymousContextService.test.ts",
    "test:haven-context": "tsx server/services/havenContextBuilder.test.ts",
    "test:today": "tsx src/services/todayContextService.test.ts && tsx src/components/today/TodayDashboard.test.ts",
    "test:resources": "tsx src/services/resourceRecommendationService.test.ts",
    "test:summary": "tsx server/services/healthSummaryService.test.ts",
    "test:sharing": "tsx src/services/sharingService.test.ts",
    "test:partner-signal": "tsx src/services/partnerContextService.test.ts",
    "test:child": "tsx src/services/childService.test.ts",
    "test:reminders": "tsx src/services/reminderGenerationService.test.ts",
    "test:demo": "tsx src/services/demoDatasetAndOnboarding.test.ts",
    "seed:clinicians": "tsx server/seed/seedDemoClinicians.ts",
    "seed:mothers": "tsx server/seed/seedDemoMothers.ts",
    "seed:demo": "tsx server/seed/seedDemo.ts",
    "verify:demo": "tsx server/seed/verifyDemoData.ts",
    "clean:demo": "tsx server/seed/cleanDemoData.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "otplib": "^13.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
